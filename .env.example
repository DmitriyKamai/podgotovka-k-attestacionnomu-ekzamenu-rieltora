# Токен бота от @BotFather
BOT_TOKEN=

# API-ключ OpenCode Go (Console -> подписка Go -> скопировать API key)
GO_API_KEY=

# Яндекс SpeechKit (распознавание голосовых сообщений)
# API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user
YANDEX_API_KEY=
# ID каталога Yandex Cloud
YANDEX_FOLDER_ID=

# Эндпоинт и модель OpenCode Go
GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
MODEL=deepseek-v4.1-flash

# Белый список Telegram ID через запятую. Пусто = доступ всем (не рекомендуется).
# Свой ID бот покажет в ответ на /start.
ALLOWED_IDS=

# Платный доступ (Telegram Stars) настраивается в самом боте:
# админ → кнопка «⚙️ Настройки» (цена, число бесплатных вопросов, вкл/выкл платного режима).
# В .env эти параметры задавать не нужно — есть значения по умолчанию.

# Внешняя база Postgres — обязательна (локальная SQLite не используется).
# Пример: DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Антиспам и защита от перегрузки
RATE_LIMIT_SECONDS=6
RATE_LIMIT_PER_HOUR=60
MAX_INPUT_CHARS=4000
MAX_VOICE_SECONDS=120
MAX_CONCURRENT_LLM=4

# История сообщений на пользователя (последние N реплик)
MAX_HISTORY=8
