# Токен бота от @BotFather
BOT_TOKEN=

# API-ключ OpenCode Go (Console -> подписка Go -> скопировать API key)
GO_API_KEY=

# Эндпоинт и модель OpenCode Go
GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
MODEL=deepseek-v4.1-flash

# Белый список Telegram ID через запятую. Пусто = доступ всем (не рекомендуется).
# Свой ID бот покажет в ответ на /start.
ALLOWED_IDS=

# История сообщений на пользователя (последние N реплик)
MAX_HISTORY=8
